                  "  pm.expect(b.diagnosis.requested).to.eql(false);",
                  "  pm.expect(b.workOrderId).to.eql(null);",
                  "});",
                  "pm.test('El vehículo vuelve a OK', () => pm.expect(b.scan.vehicle.status).to.eql('OK'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
