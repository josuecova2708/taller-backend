              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Existe una orden abierta para el vehículo con fallas', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const abierta = pm.response",
                  "    .json()",
                  "    .find((o) => o.vehicle && o.vehicle.vin === pm.environment.get('vinPrueba') && ['OPEN', 'IN_PROGRESS'].includes(o.status));",
                  "  pm.expect(abierta, 'orden abierta').to.exist;",
                  "  pm.collectionVariables.set('orderId', abierta.id);",
