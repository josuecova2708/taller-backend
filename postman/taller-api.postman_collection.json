          "name": "Login administrador",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 y devuelve un token JWT', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.accessToken).to.be.a('string').and.not.empty;",
                  "  pm.collectionVariables.set('adminToken', b.accessToken);",
                  "  pm.collectionVariables.set('adminId', b.user.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
