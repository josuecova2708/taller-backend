generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  INSPECTOR
  MECHANIC
  ADMIN
}

enum VehicleStatus {
  OK
  ALERT
  CRITICAL
}

enum DtcType {
  CONFIRMED
  PENDING
  PERMANENT
}

enum ScanSeverity {
  NONE
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum WorkOrderStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum WorkOrderPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  role         UserRole  @default(INSPECTOR)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())

  scans        Scan[]
  workOrders   WorkOrder[] @relation("AssignedTo")
  closedOrders WorkOrder[] @relation("ClosedBy")
  devices      Device[]

  @@map("users")
}

/// Teléfono registrado para recibir notificaciones push (CU18).
/// El token lo entrega Firebase a la app; un teléfono pertenece a la última
/// cuenta que inició sesión en él.
model Device {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String   @default("android")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("devices")
}

model Vehicle {
  id        String        @id @default(uuid())
  vin       String?       @unique
  plate     String        @unique
  alias     String?
  make      String?
  model     String?
  year      Int?
  status    VehicleStatus @default(OK)
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())

  scans      Scan[]
  workOrders WorkOrder[]

  @@map("vehicles")
}

model Scan {
  id              String       @id @default(uuid())
  vehicleId       String
  scannedById     String
  batteryVoltage  Float?
  scannedAt       DateTime
  rawPayload      Json?
  readinessStatus Json?
  protocol        Json?
  notes           String?
  rationale       String?
  severity        ScanSeverity @default(NONE)
  aiProcessed     Boolean      @default(false)
  createdAt       DateTime     @default(now())

  vehicle    Vehicle    @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  scannedBy  User       @relation(fields: [scannedById], references: [id])
  dtcEntries DtcEntry[]
  diagnosis  Diagnosis?
  workOrder  WorkOrder?

  @@map("scans")
}

model DtcEntry {
  id     String  @id @default(uuid())
  scanId String
  code   String
  type   DtcType

  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@map("dtc_entries")
}

model Diagnosis {
  id              String   @id @default(uuid())
  scanId          String   @unique
  provider        String
  prompt          String
  response        String
  summary         String
  severity        String
  recommendations Json
  tokensUsed      Int?
  latencyMs       Int?
  createdAt       DateTime @default(now())

  scan      Scan       @relation(fields: [scanId], references: [id], onDelete: Cascade)
  workOrder WorkOrder?

  @@map("diagnoses")
}

model WorkOrder {
  id           String            @id @default(uuid())
  scanId       String            @unique
  diagnosisId  String?           @unique
  vehicleId    String
  assignedToId String?
  status       WorkOrderStatus   @default(OPEN)
  priority     WorkOrderPriority @default(MEDIUM)
  description  String
  notes        String?
  n8nNotified  Boolean           @default(false)
  closedById   String?
  closedAt     DateTime?
  operationAuthorized Boolean    @default(false)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  scan       Scan       @relation(fields: [scanId], references: [id], onDelete: Cascade)
  diagnosis  Diagnosis? @relation(fields: [diagnosisId], references: [id], onDelete: SetNull)
  vehicle    Vehicle    @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  assignedTo User?      @relation("AssignedTo", fields: [assignedToId], references: [id])
  closedBy   User?      @relation("ClosedBy", fields: [closedById], references: [id])

  @@map("work_orders")
}
