# ---------- Base de datos (Neon PostgreSQL 16, WebSocket/443) ----------
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ---------- Autenticación ----------
# OBLIGATORIO. Mínimo 32 caracteres; el backend se niega a arrancar con un
# valor de ejemplo o demasiado corto. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# ---------- CORS ----------
# Orígenes permitidos, separados por coma.
CORS_ORIGINS="http://localhost:3001,http://localhost:3000"

# ---------- IA interpretativa (Fase 3) ----------
AI_PROVIDER="claude"
AI_MODEL="claude-sonnet-5"
AI_EFFORT="low"
AI_MAX_TOKENS="8192"
ANTHROPIC_API_KEY="your-anthropic-api-key"
OLLAMA_BASE_URL="http://localhost:11434"

# ---------- Automatización con n8n ----------
# Todas opcionales: sin ellas el sistema funciona, pero no envía avisos.
# URL de producción del webhook del flujo «Taller: alerta de orden de trabajo»
# (termina en /webhook/taller-scan-alert). Vacía = no se avisa a n8n.
N8N_WEBHOOK_URL=""
# Mismo valor que la credencial «Header Auth» del webhook (cabecera X-Webhook-Secret).
N8N_WEBHOOK_SECRET=""
# Clave con la que n8n pide el resumen diario (cabecera X-Service-Key).
N8N_SERVICE_KEY=""
# Dirección pública de la web, para que los avisos lleven un enlace a la orden.
APP_PUBLIC_URL="http://localhost:3001"

# ---------- Notificaciones push (Firebase Cloud Messaging) ----------
# Opcional: sin ella el sistema funciona, pero no envía push al celular.
# Clave de la cuenta de servicio de Firebase (Configuración del proyecto →
# Cuentas de servicio → Generar nueva clave privada). Admite tres formas:
#   - la ruta al archivo .json            (cómodo en la PC)
#   - el contenido del .json en una línea
#   - el contenido del .json en base64    (cómodo en Azure)
# El archivo es un secreto: nunca va al repositorio.
FIREBASE_SERVICE_ACCOUNT=""

PORT=3000
