# ---------- Base de datos (Neon PostgreSQL 16, WebSocket/443) ----------
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ---------- Autenticación ----------
# OBLIGATORIO. Mínimo 32 caracteres; el backend se niega a arrancar con un
# valor de ejemplo o demasiado corto. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# ---------- CORS ----------
# Orígenes permitidos, separados por coma.
CORS_ORIGINS="http://localhost:3001,http://localhost:3000"

# ---------- IA interpretativa (Fase 3) ----------
AI_PROVIDER="claude"
AI_MODEL="claude-opus-5"
ANTHROPIC_API_KEY="your-anthropic-api-key"
OLLAMA_BASE_URL="http://localhost:11434"

# ---------- Automatización (Fase 5) ----------
N8N_WEBHOOK_URL="http://localhost:5678/webhook"

PORT=3000
